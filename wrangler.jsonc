{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibelex-attendance",
  "compatibility_date": "2026-11-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "clock.jianfalab.com",
      "custom_domain": true
    }
  ]
}
